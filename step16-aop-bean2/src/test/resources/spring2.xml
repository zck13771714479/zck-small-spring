<?xml version="1.0" encoding="UTF-8"?>
<beans>

    <bean class="com.zck.beans.factory.PropertyPlaceholderConfigurer">
        <property name="location" value="classpath:token.properties"/>
    </bean>

    <bean class="com.zck.aop.framework.autoproxy.DefaultAdvisorAutoProxyCreator"/>

    <bean id="beforeAdvice" class="bean2.UserServiceBeforeAdvice"/>

    <bean id="methodInterceptor" class="com.zck.aop.framework.adapter.MethodBeforeAdviceInterceptor">
        <property name="advice" ref="beforeAdvice"/>
    </bean>

    <bean id="pointcutAdvisor" class="com.zck.aop.aspectj.AspectJExpressionPointcutAdvisor">
        <property name="expression" value="execution(* bean2.IUserService.*(..))"/>
        <property name="advice" ref="methodInterceptor"/>
    </bean>

    <component-scan base-package="bean2"/>
</beans>